# Gemini API Key (Required for image generation)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the fixed upstream relay endpoint used by the backend.
# Default is https://max.aittco.com
UPSTREAM_URL=https://max.aittco.com

# Notes:
# - Use the UI settings panel if you prefer not to use .env file.
# - Port 3322: Frontend (Vite)
# - Port 3325: Backend Server (Node.js)
